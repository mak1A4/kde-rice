# Builds and installs kde-rice from this checkout (../install.sh runs it):
#
#   cd packaging && makepkg -si
#
# The KWin plugins and the decoration are built against the KWin installed
# now: run it again after each Plasma update.
#
# Two packages from one build: kde-rice-git, and kde-rice-whitesur-git with
# kde-rice's icons (WhiteSur's ~44000 files, which take most of the time to
# package and install). With KDERICE_WHITESUR=0 only kde-rice-git is made:
# install.sh does that when what the icons are made from has not changed
# (whitesur-inputs).
pkgbase=kde-rice-git
pkgname=(kde-rice-git kde-rice-whitesur-git)
if [ "${KDERICE_WHITESUR:-1}" = 0 ]; then
    pkgname=(kde-rice-git)
fi
pkgver=r23.c9c2501
pkgrel=1
pkgdesc="One place to customize KDE Plasma: a hub application and the KWin and Plasma parts it switches on"
arch=(x86_64)
url="https://github.com/mak1A4/kde-rice"
# kde-rice GPL-3; WhiteSur (shipped as kde-rice-whitesur) GPL-3
license=(GPL-3.0-or-later)
depends=(kwin kdecoration kconfig kcoreaddons ki18n kcolorscheme kguiaddons kiconthemes kitemmodels
         kirigami kirigami-addons qqc2-desktop-style qt6-base qt6-declarative qt6-multimedia
         krunner kglobalaccel kdbusaddons layer-shell-qt plasma-workspace librsvg cairo)
optdepends=('ffmpeg: pictures of backgrounds on the Appearance page'
            'plasma-login-manager: the login screen in step with the session')
makedepends=(cmake extra-cmake-modules ninja git patch gtk-update-icon-cache)
provides=(kde-rice)
conflicts=(kde-rice)
# Built without debug symbols, so nothing to strip: makepkg's stripping
# looks at every one of WhiteSur's ~44000 files and took nine tenths of the
# time. No link-time optimisation either, which made each change relink
# everything slowly.
options=(!strip !debug !lto)

_repo=$(realpath "$startdir/..")

pkgver() {
    printf "r%s.%s" "$(git -C "$_repo" rev-list --count HEAD)" "$(git -C "$_repo" rev-parse --short HEAD)"
}

build() {
    cmake -S "$_repo" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF \
        `# makepkg's flags of now, over those the build directory kept from its first run` \
        -DCMAKE_C_FLAGS="$CFLAGS" -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
        -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS" -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS" -DCMAKE_MODULE_LINKER_FLAGS="$LDFLAGS"
    cmake --build build
}

package_kde-rice-git() {
    depends+=(kde-rice-whitesur-git)
    DESTDIR="$pkgdir" cmake --install build --component kde-rice
}

package_kde-rice-whitesur-git() {
    pkgdesc="kde-rice's icons: WhiteSur, with -light and -dark variants and kde-rice's own pictures"
    arch=(any)
    depends=()
    optdepends=()
    provides=(kde-rice-whitesur)
    conflicts=(kde-rice-whitesur)
    DESTDIR="$pkgdir" cmake --install build --component whitesur
    install -Dm644 /dev/stdin "$pkgdir/usr/share/kde-rice/whitesur-inputs" <<< "$("$startdir/whitesur-inputs")"
}

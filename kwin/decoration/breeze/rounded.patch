 //________________________________________________________________
+bool Decoration::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == parent() && event->type() == QEvent::DynamicPropertyChange
+        && static_cast<QDynamicPropertyChangeEvent *>(event)->propertyName() == "kdeRiceJoinedEdges") {
+        QMetaObject::invokeMethod(this, &Decoration::updateJoined, Qt::QueuedConnection);
+    }
+    return KDecoration3::Decoration::eventFilter(watched, event);
+}
+
+void Decoration::updateJoined()
+{
+    const int joined = parent() ? parent()->property("kdeRiceJoinedEdges").toInt() : 0;
+    if (joined == m_joinedEdges) {
+        return;
+    }
+    m_joinedEdges = joined;
+    recalculateBorders();
+    updateShadow();
+    update();
+}
+
+// kde-rice: the sides as kwin/plugins/roundcorners gives them
+enum JoinedEdge {
+    JoinedLeft = 1,
+    JoinedTop = 2,
+    JoinedRight = 4,
+    JoinedBottom = 8,
+};
+
+KDecoration3::BorderRadius Decoration::joinedRadius(qreal topLeft, qreal topRight, qreal bottomRight, qreal bottomLeft) const
+{
+    const int joined = m_joinedEdges;
+    return KDecoration3::BorderRadius(joined & (JoinedLeft | JoinedTop) ? 0 : topLeft,
+                                      joined & (JoinedRight | JoinedTop) ? 0 : topRight,
+                                      joined & (JoinedRight | JoinedBottom) ? 0 : bottomRight,
+                                      joined & (JoinedLeft | JoinedBottom) ? 0 : bottomLeft);
+}
+
+// a rectangle with its own radius at each corner, none where joined
+QPainterPath Decoration::joinedRect(const QRectF &rect, qreal topLeft, qreal topRight, qreal bottomRight, qreal bottomLeft) const
+{
+    const KDecoration3::BorderRadius radius = joinedRadius(topLeft, topRight, bottomRight, bottomLeft);
+    const qreal most = std::min(rect.width(), rect.height()) / 2;
+    const qreal tl = std::min(radius.topLeft(), most);
+    const qreal tr = std::min(radius.topRight(), most);
+    const qreal br = std::min(radius.bottomRight(), most);
+    const qreal bl = std::min(radius.bottomLeft(), most);
+    QPainterPath path;
+    path.moveTo(rect.left() + tl, rect.top());
+    path.lineTo(rect.right() - tr, rect.top());
+    if (tr > 0) {
+        path.arcTo(QRectF(rect.right() - 2 * tr, rect.top(), 2 * tr, 2 * tr), 90, -90);
+    }
+    path.lineTo(rect.right(), rect.bottom() - br);
+    if (br > 0) {
+        path.arcTo(QRectF(rect.right() - 2 * br, rect.bottom() - 2 * br, 2 * br, 2 * br), 0, -90);
+    }
+    path.lineTo(rect.left() + bl, rect.bottom());
+    if (bl > 0) {
+        path.arcTo(QRectF(rect.left(), rect.bottom() - 2 * bl, 2 * bl, 2 * bl), 270, -90);
+    }
+    path.lineTo(rect.left(), rect.top() + tl);
+    if (tl > 0) {
+        path.arcTo(QRectF(rect.left(), rect.top(), 2 * tl, 2 * tl), 180, -90);
+    }
+    path.closeSubpath();
+    return path;
+}
